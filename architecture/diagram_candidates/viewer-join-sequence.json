{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Viewer Join & Host Authorization Sequence",
    "output": "web/public/architecture/diagrams/viewer-join-sequence.html",
    "viewBox": [
      1080,
      640
    ],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "guest",
      "type": "external",
      "label": "Guest User",
      "sublabel": "Browser Session"
    },
    {
      "id": "web_ui",
      "type": "frontend",
      "label": "Web UI",
      "sublabel": "shellvyn.reck98.in"
    },
    {
      "id": "relay",
      "type": "cloud",
      "label": "Signaling Relay",
      "sublabel": "Axum Service"
    },
    {
      "id": "host_cli",
      "type": "backend",
      "label": "Host CLI",
      "sublabel": "crates/shellvyn-agent"
    },
    {
      "id": "host_user",
      "type": "external",
      "label": "Host Developer",
      "sublabel": "Local Terminal"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 260,
      "label": "Pairing Initiation"
    },
    {
      "from": 270,
      "to": 390,
      "label": "Host Authorization & Salt Exchange"
    },
    {
      "from": 400,
      "to": 490,
      "label": "Encrypted Streaming Active"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "guest",
      "to": "web_ui",
      "y": 160,
      "label": "enter pairing code (K7M2-9XPQ)",
      "variant": "default"
    },
    {
      "id": "m2",
      "from": "web_ui",
      "to": "relay",
      "y": 195,
      "label": "WS: {\"type\":\"join\", \"code\":\"...\"}",
      "variant": "emphasis"
    },
    {
      "id": "m3",
      "from": "relay",
      "to": "host_cli",
      "y": 230,
      "label": "WS: PairRequest(client_id, ip, ua)",
      "variant": "security"
    },
    {
      "id": "m4",
      "from": "host_cli",
      "to": "host_user",
      "y": 265,
      "label": "Prompt: Approve guest from IP? [y/N]",
      "variant": "security"
    },
    {
      "id": "m5",
      "from": "host_user",
      "to": "host_cli",
      "y": 300,
      "label": "Developer approves [y]",
      "variant": "emphasis"
    },
    {
      "id": "m6",
      "from": "host_cli",
      "to": "relay",
      "y": 335,
      "label": "WS: PairAccept(permission: interactive)",
      "variant": "emphasis"
    },
    {
      "id": "m7",
      "from": "relay",
      "to": "web_ui",
      "y": 370,
      "label": "WS: JoinResult(status: connected, salt)",
      "variant": "return"
    },
    {
      "id": "m8",
      "from": "host_cli",
      "to": "relay",
      "y": 415,
      "label": "RelayData(ChaCha20 ciphertext)",
      "variant": "emphasis"
    },
    {
      "id": "m9",
      "from": "relay",
      "to": "web_ui",
      "y": 445,
      "label": "Forward ciphertext payload",
      "variant": "emphasis"
    },
    {
      "id": "m10",
      "from": "web_ui",
      "to": "guest",
      "y": 475,
      "label": "Render live terminal screen",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "web_ui",
      "from": 160,
      "to": 485,
      "type": "frontend"
    },
    {
      "participant": "relay",
      "from": 195,
      "to": 455,
      "type": "cloud"
    },
    {
      "participant": "host_cli",
      "from": 230,
      "to": 430,
      "type": "backend"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Two-Way Authentication",
      "items": [
        "The guest possesses the secret pairing code",
        "The host must explicitly approve before any bytes flow",
        "Session salt ensures fresh session key generation per connection"
      ]
    }
  ]
}