    "animation": "trace",
    "quality_profile": "showcase"
  },
  "stages": [
    {
      "label": "Ingest"
    },
    {
      "label": "Transform"
    },
    {
      "label": "Cryptographic Core"
    },
    {
      "label": "Demux"
    },
    {
      "label": "Render / Dispatch"
    }
  ],
  "nodes": [
    {
      "id": "ws_frame",
      "type": "cloud",
      "label": "WebSocket Frame",
      "sublabel": "Ciphertext",
      "stage": 0,
      "row": 0,
      "tag": "WSS In"
    },
    {
      "id": "b64_decode",
      "type": "backend",
      "label": "Base64 Decoder",
      "sublabel": "Uint8Array",
      "stage": 1,
      "row": 0,
      "tag": "Raw Bytes"
    },
    {
      "id": "chacha_dec",
      "type": "security",
      "label": "ChaCha20 Decrypt",
      "sublabel": "256-bit Key",
      "stage": 2,
      "row": 0,
      "tag": "Web Crypto"
    },
    {
      "id": "frame_demux",
      "type": "backend",
      "label": "Binary Demux",
      "sublabel": "0x01 / 0x02",
      "stage": 3,
      "row": 0,
      "tag": "Demuxer"
    },
    {
      "id": "ansi_parser",
      "type": "frontend",
      "label": "ANSI Parser",
      "sublabel": "VT100 Engine",
      "stage": 4,
      "row": 0,
      "tag": "xterm Core"
    },
    {
      "id": "canvas_out",
      "type": "frontend",
      "label": "Canvas Viewport",
      "sublabel": "WebGL 60 FPS",
      "stage": 4,
      "row": 1,
      "tag": "Screen"
