    {
      "id": "key_press",
      "type": "frontend",
      "label": "Keystroke Event",
      "sublabel": "term.onData()",
      "stage": 0,
      "row": 2,
      "tag": "User Input"
    },
    {
      "id": "chacha_enc",
      "type": "security",
      "label": "ChaCha20 Encrypt",
      "sublabel": "Poly1305 Tag",
      "stage": 2,
      "row": 2,
      "tag": "Tag Append"
    },
    {
      "id": "ws_tx",
      "type": "cloud",
      "label": "Relay Dispatch",
      "sublabel": "WSS Payload",
      "stage": 4,
      "row": 2,
      "tag": "WSS Out"
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "ws_frame",
      "to": "b64_decode",
      "label": "base64 payload",
      "classification": "envelope",
      "variant": "default"
    },
    {
      "id": "f2",
      "from": "b64_decode",
      "to": "chacha_dec",
      "label": "ciphertext bytes",
      "classification": "crypto",
      "variant": "security"
    },
    {
      "id": "f3",
      "from": "chacha_dec",
      "to": "frame_demux",
      "label": "plaintext frame",
      "classification": "binary",
      "variant": "emphasis"
    },
    {
      "id": "f4",
      "from": "frame_demux",
      "to": "ansi_parser",
      "label": "0x01 PTY stdout",
      "classification": "terminal",
      "variant": "emphasis"
    },
    {
      "id": "f5",
      "from": "ansi_parser",
      "to": "canvas_out",
      "label": "glyph drawing",
      "classification": "render",
      "variant": "default"
    },
    {
      "id": "f6",
      "from": "key_press",
      "to": "chacha_enc",
      "label": "keystroke bytes",
      "classification": "input",
      "variant": "security"
    },
    {
      "id": "f7",
      "from": "chacha_enc",
      "to": "ws_tx",
      "label": "ciphertext payload",
      "classification": "outbound",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Zero Plaintext Exposure",
      "items": [
        "Ciphertext enters browser and is decrypted exclusively in Web Worker / main thread memory",
        "Plaintext bytes are fed directly to xterm parser without hitting DOM attributes"
      ]
    },
    {
      "dot": "cyan",
      "title": "Low Latency Loop",
      "items": [
        "Keystroke input triggers instant encryption and transmission without batching delay",
        "Sub-15ms round-trip latency over WebSocket relay"
      ]
    }
  ]
}